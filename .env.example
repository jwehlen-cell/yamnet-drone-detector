# QST API credentials (client-credentials OAuth via Keycloak).
# Copy this file to `.env` and fill in the real secret. `.env` is gitignored.
QST_KC_URL=https://auth.project-argos.com
QST_REALM=qst
QST_CLIENT_ID=qst-api
QST_CLIENT_SECRET=your-client-secret
# Base URL of the QST data/query API (the host that serves /api/stream/audio).
QST_API_BASE=https://qst.project-argos.com
